/* PC stand-in for the MSL C++ <vector>: the subset the game uses, with the
 * member layout of the Metrowerks one (capacity, size, data; the allocator
 * is empty), so that objects containing a vector keep their offsets.
 * Iterators are plain pointers, as in MSL. */
#ifndef MKGP2PC_VECTOR
#define MKGP2PC_VECTOR
#include <stddef.h>
#include <new>

namespace std {

template <class T> class vector {
public:
    typedef T value_type;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef T &reference;
    typedef const T &const_reference;
    typedef size_t size_type;

    vector() : capacity_(0), size_(0), data_(0) {}
    explicit vector(size_type n, const T &value = T()) : capacity_(0), size_(0), data_(0) {
        reserve(n);
        for (size_type i = 0; i < n; i++) new (data_ + i) T(value);
        size_ = n;
    }
    vector(const vector &o) : capacity_(0), size_(0), data_(0) { assign(o); }
    ~vector() {
        clear();
        ::operator delete((void *)data_);
    }
    vector &operator=(const vector &o) {
        if (this != &o) {
            clear();
            assign(o);
        }
        return *this;
    }

    iterator begin() { return data_; }
    const_iterator begin() const { return data_; }
    iterator end() { return data_ + size_; }
    const_iterator end() const { return data_ + size_; }
    size_type size() const { return size_; }
    size_type capacity() const { return capacity_; }
    bool empty() const { return size_ == 0; }
    reference operator[](size_type i) { return data_[i]; }
    const_reference operator[](size_type i) const { return data_[i]; }
    /* MSL throws std::out_of_range here; the stand-in stops instead */
    reference at(size_type i) { if (i >= size_) __builtin_trap(); return data_[i]; }
    const_reference at(size_type i) const { if (i >= size_) __builtin_trap(); return data_[i]; }
    reference front() { return data_[0]; }
    const_reference front() const { return data_[0]; }
    reference back() { return data_[size_ - 1]; }
    const_reference back() const { return data_[size_ - 1]; }

    void reserve(size_type n) {
        if (n <= capacity_) return;
        T *p = static_cast<T *>(::operator new(n * sizeof(T)));
        for (size_type i = 0; i < size_; i++) {
            new (p + i) T(data_[i]);
            data_[i].~T();
        }
        ::operator delete((void *)data_);
        data_ = p;
        capacity_ = n;
    }
    void push_back(const T &value) {
        if (size_ == capacity_) {
            T copy(value); /* value may live in this vector */
            reserve(capacity_ ? capacity_ * 2 : 1);
            new (data_ + size_) T(copy);
        } else {
            new (data_ + size_) T(value);
        }
        size_++;
    }
    void pop_back() { data_[--size_].~T(); }
    iterator insert(iterator pos, const T &value) {
        size_type at = pos - data_;
        push_back(value);
        for (size_type i = size_ - 1; i > at; i--) {
            T t(data_[i]);
            data_[i] = data_[i - 1];
            data_[i - 1] = t;
        }
        return data_ + at;
    }
    iterator erase(iterator pos) { return erase(pos, pos + 1); }
    iterator erase(iterator first, iterator last) {
        size_type n = last - first;
        for (iterator p = first; p + n != end(); p++) *p = p[n];
        for (size_type i = 0; i < n; i++) data_[--size_].~T();
        return first;
    }
    void resize(size_type n, const T &value = T()) {
        while (size_ > n) pop_back();
        reserve(n);
        while (size_ < n) push_back(value);
    }
    void clear() {
        while (size_) data_[--size_].~T();
    }

private:
    void assign(const vector &o) {
        reserve(o.size_);
        for (size_type i = 0; i < o.size_; i++) new (data_ + i) T(o.data_[i]);
        size_ = o.size_;
    }
    size_type capacity_;
    size_type size_;
    T *data_;
};

} // namespace std
#endif
