+/* PC port: the key tables are Shift-JIS text (two bytes a key, high byte
+ * first), read by the arcade program as 16-bit numbers. On a little-endian
+ * host the plain read gives the two bytes the other way round, and no key
+ * finds its picture. */
+static inline unsigned short KeyCode(const unsigned short *p) {
+    const unsigned char *b = (const unsigned char *)p;
+    return (unsigned short)(b[0] << 8 | b[1]);
+}
 
